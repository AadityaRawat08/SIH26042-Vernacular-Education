# =============================================================================
# Example environment file for local development.
# Copy this file to `.env` (git-ignored) and adjust values.
# Real secrets MUST be provided via environment variables and NEVER committed.
# The `compose.yaml` file reads DB_* variables from the active environment.
# =============================================================================

# --- Spring Profile ----------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# --- PostgreSQL --------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/prototype
DB_USERNAME=prototype
DB_PASSWORD=change-me-in-production
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
# 1  = fail fast if DB is unreachable at startup (recommended)
# -1 = do not test connectivity at startup (app starts without DB)
DB_INIT_FAIL_TIMEOUT=1

# --- JPA / Hibernate ---------------------------------------------------------
# none | validate | update | create | create-drop  (always "none"/"validate" outside local dev)
# The default "local" profile (application-local.yml) uses "update" so Hibernate
# can create the schema during development; set JPA_DDL_AUTO to override it.
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false

# --- JWT authentication -------------------------------------------------------
# REQUIRED for anything beyond local development. Minimum 32 characters
# (256 bits for HMAC-SHA256). Generate with:  openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=prototype-backend
# Duration format: 15m, 30m, 12h, 7d, or plain seconds.
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# --- Server -------------------------------------------------------------------
SERVER_PORT=8080

# --- CORS ----------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# This is the frontend development server (see FrontEnd/vite.config.ts).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Actuator -----------------------------------------------------------------
# Controls how much detail /actuator/health reveals. Options: never, when-authorized, always.
ACTUATOR_HEALTH_SHOW_DETAILS=always

# --- External AI services (local prototype) -----------------------------------
# The backend is the only thing that talks to these Python services.
#   TRANSLATION_PROVIDER=mock  → local mock translator (default, no network)
#   TRANSLATION_PROVIDER=http  → call ai-translation service on AI_TRANSLATION_BASE_URL
#   SPEECH_PROVIDER=mock       → local mock speech (default, no network)
#   SPEECH_PROVIDER=http       → call voice-service on VOICE_SERVICE_BASE_URL
TRANSLATION_PROVIDER=mock
AI_TRANSLATION_BASE_URL=http://localhost:8000
AI_TRANSLATION_TIMEOUT_SECONDS=15
SPEECH_PROVIDER=mock
VOICE_SERVICE_BASE_URL=http://localhost:8001
VOICE_SERVICE_TIMEOUT_SECONDS=15

# --- Logging -------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=WARN