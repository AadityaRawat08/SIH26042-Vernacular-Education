# Copy this file to `.env` and adjust values.
# Backend API base URL used by the centralized API client (src/lib/api/client.ts).
# The Spring Boot backend runs on http://localhost:8080 during local development.
VITE_API_BASE_URL=http://localhost:8080

# Optional: local demo account.
# The Spring Boot backend protects /api/translations, /api/speech and /api/ocr
# with JWT authentication. When enabled, the app signs in with this LOCAL
# DEVELOPMENT account (registering it on first use) so the translation, speech
# and OCR flows are usable without a sign-up step.
#
# These are local-only demo credentials — not an API key, not a production
# secret. Set VITE_DEMO_ACCOUNT_ENABLED=false to require a real sign-in.
VITE_DEMO_ACCOUNT_ENABLED=true
VITE_DEMO_ACCOUNT_EMAIL=demo.teacher@tribhashniya.local
VITE_DEMO_ACCOUNT_PASSWORD=DemoTeacher#2026
VITE_DEMO_ACCOUNT_USERNAME=demo_teacher

# NOTE: never put the Bhashini (or any other AI provider) key here. Only the
# Python AI translation service reads it, and the frontend never calls Bhashini
# directly.